{
	"compilerOptions": {
		"target": "es2024",
		"module": "nodenext",
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"moduleResolution": "nodenext",
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
